      "source": [
        "import os\n",
        "import torch\n",
        "from dotenv import load_dotenv\n",
        "from transformers import AutoProcessor\n",
        "\n",
        "# Optional: speed up HF downloads / reduce warnings\n",
        "os.environ.setdefault(\"HF_HUB_ENABLE_HF_TRANSFER\", \"1\")\n",
        "os.environ.setdefault(\"HF_HUB_DISABLE_SYMLINKS_WARNING\", \"1\")\n",
        "\n",
        "load_dotenv()\n",
        "hf_token = os.getenv(\"HF_TOKEN\")\n",
        "\n",
        "# Prefer Qwen2-VL if AutoModelForVision2Seq is available; otherwise fall back to LLaVA.\n",
        "try:\n",
        "    from transformers import AutoModelForVision2Seq\n",
        "    MODEL_DIR = \"Qwen/Qwen2-VL-2B-Instruct\"\n",
        "    _MODEL_CLS = AutoModelForVision2Seq\n",
        "except ImportError:\n",
        "    from transformers import LlavaForConditionalGeneration\n",
        "    MODEL_DIR = \"llava-hf/llava-1.5-7b-hf\"\n",
        "    _MODEL_CLS = LlavaForConditionalGeneration\n",
        "\n",
        "processor = AutoProcessor.from_pretrained(MODEL_DIR, token=hf_token)\n",
        "\n",
        "# 4-bit quantization disabled (set up later if desired)\n",
        "use_4bit = False\n",
        "\n",
        "model = _MODEL_CLS.from_pretrained(\n",
        "    MODEL_DIR,\n",
        "    torch_dtype=torch.float16,\n",
        "    device_map=\"auto\",\n",
        "    trust_remote_code=True,\n",
        "    token=hf_token\n",
        ")\n"
      ],
      "id": "0tczeiv9IBKL"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "pu5ZfgjXIBKN"
      },
      "source": [
        "## 2) Single‑image defect detection"
      ],
      "id": "pu5ZfgjXIBKN"
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "e6mMJ244IBKN",
        "outputId": "b4ab4f17-24e8-489e-b6fd-49e0ee652323"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "User:  \n",
            "Describe lighting defects in this render.\n",
            "Assistant: In the image, there is a lighting defect in the form of a light source that is not properly lit. The light is shining on a metal object, which is located in a room with a white wall. The light source appears to be a single light bulb, and it is not evenly distributed, causing a noticeable shadow on the wall. This uneven lighting can create an unflattering or unappealing atmosphere in the room. To improve the lighting, it would be beneficial to use multiple light sources or adjust the positioning of the existing light source to create a more even distribution of light\n"
          ]
        }
      ],
      "source": [
        "image_path = \"/content/Defect.jpeg\"\n",
    "question = (\"Inspect the scene for lighting anomalies. Look for pre-baked remnants from previous \"
    "            \"lighting, mismatched light direction vs. visible light sources, uneven light distribution, \"
    "            \"banding, and incorrect shadowing. Summarize any defects clearly.\")\n",
        "\n",
        "prompt = f\"User: <image>\\n{question}\\nAssistant:\"\n",
        "inputs = processor(text=prompt, images=image_path, return_tensors=\"pt\").to(model.device)\n",
        "\n",
        "with torch.no_grad():\n",
        "    output = model.generate(**inputs, max_new_tokens=128)\n",
        "\n",
        "print(processor.decode(output[0], skip_special_tokens=True))\n"
      ],
      "id": "e6mMJ244IBKN"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "nAOARkprIBKO"
      },
      "source": [
        "## 3) Create a defect mask (heuristic) for lighting anomalies"
      ],
      "id": "nAOARkprIBKO"
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 264
        },
        "id": "p8DwOg-cIBKO",
        "outputId": "308aadbb-5dfa-49f0-ef7d-21c7c21282a3"
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x400 with 3 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "image_path = \"/content/Defect.jpeg\"\n",
        "\n",
        "bgr = cv2.imread(image_path)\n",
        "if bgr is None:\n",
        "    raise FileNotFoundError(f\"Could not read image: {image_path}\")\n",
        "rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)\n",
        "gray = cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "illum = cv2.GaussianBlur(gray, (0, 0), sigmaX=25, sigmaY=25)\n",
        "residual = cv2.absdiff(gray, illum)\n",
        "residual = cv2.normalize(residual, None, 0, 255, cv2.NORM_MINMAX)\n",
        "\n",
        "_, mask = cv2.threshold(residual, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n",
        "\n",
        "kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n",
        "mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1)\n",
        "mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=1)\n",
        "\n",
        "overlay = rgb.copy()\n",
        "overlay[mask > 0] = [255, 0, 0]\n",
        "blend = cv2.addWeighted(overlay, 0.4, rgb, 0.6, 0)\n",
        "\n",
        "cv2.imwrite(\"lighting_defect_mask.png\", mask)\n",
        "cv2.imwrite(\"lighting_defect_overlay.png\", cv2.cvtColor(blend, cv2.COLOR_RGB2BGR))\n",
        "\n",
        "plt.figure(figsize=(12, 4))\n",
        "plt.subplot(1, 3, 1)\n",
        "plt.title('Input')\n",
        "plt.imshow(rgb)\n",
        "plt.axis('off')\n",
        "\n",
        "plt.subplot(1, 3, 2)\n",
        "plt.title('Residual')\n",
        "plt.imshow(residual, cmap='gray')\n",
        "plt.axis('off')\n",
        "\n",
        "plt.subplot(1, 3, 3)\n",
        "plt.title('Mask Overlay')\n",
        "plt.imshow(blend)\n",
        "plt.axis('off')\n",
        "plt.show()\n"
      ],
      "id": "p8DwOg-cIBKO"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "KzvpLtQIIBKP"
      },
      "source": [
        "## 4) Batch inference on a folder"
      ],
      "id": "KzvpLtQIIBKP"
    },
    {
      "cell_type": "code",
      "execution_count": 10,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ERUTUSOVIBKP",
        "outputId": "8b8d191b-83b7-4b8d-8f9e-a2f4854ca8f8"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Saved predictions to ./lighting_defect_predictions.jsonl\n"
          ]
        }
      ],
      "source": [
        "import json\n",
        "from glob import glob\n",
        "\n",
        "image_dir = \"./images\"\n",
        "out_path = \"./lighting_defect_predictions.jsonl\"\n",
        "question = \"Describe lighting defects in this render.\"\n",
        "\n",
        "paths = sorted(glob(f\"{image_dir}/*.jpg\"))\n",
        "\n",
        "with open(out_path, \"w\", encoding=\"utf-8\") as f:\n",
        "    for p in paths:\n",
        "        prompt = f\"User: <image>\\n{question}\\nAssistant:\"\n",
        "        inputs = processor(text=prompt, images=p, return_tensors=\"pt\").to(model.device)\n",
        "        with torch.no_grad():\n",
        "            output = model.generate(**inputs, max_new_tokens=128)\n",
        "        pred = processor.decode(output[0], skip_special_tokens=True)\n",
        "        rec = {\"image\": p, \"question\": question, \"prediction\": pred}\n",
        "        f.write(json.dumps(rec) + \"\\n\")\n",
        "\n",
        "print(f\"Saved predictions to {out_path}\")\n"
      ],
      "id": "ERUTUSOVIBKP"
    }
